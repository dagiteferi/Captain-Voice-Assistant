# ──────────────────────────────────────────────────
# Captain Voice Assistant — Backend .env
# ──────────────────────────────────────────────────

# ── General ───────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM (Google Gemini — free tier) ───────────────
# Get your free key at: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# ── TTS (Google Cloud Text-to-Speech — free tier) ─
# Enable API: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Create API key: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
GOOGLE_TTS_VOICE_EN=en-US-Neural2-D
GOOGLE_TTS_VOICE_AM=am-ET-Standard-A

# ── Translation (MyMemory — free, no key needed) ──
# Optional: set email to get 10,000 req/day instead of 1,000
MYMEMORY_EMAIL=

# ── Database ──────────────────────────────────────
SQLITE_URL=sqlite+aiosqlite:///./data/captain.db

# ── Directories ───────────────────────────────────
AUDIO_DIR=./data/audio
CHROMA_DIR=./chroma

# ── CORS (comma-separated frontend origins) ───────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
